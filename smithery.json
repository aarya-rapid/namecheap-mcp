{
  "id": "aarya/namecheap-mcp",
  "name": "Namecheap Domain Search MCP",
  "description": "Search and suggest domains using Namecheap's API with fuzzy variants and buy links.",
  "tags": ["domains", "namecheap", "search", "branding"],
  "deployment": {
    "localOnly": false,
    "requirements": [
      {
        "name": "NAMECHEAP_API_USER",
        "description": "Namecheap API username",
        "required": true
      },
      {
        "name": "NAMECHEAP_API_KEY",
        "description": "Namecheap API key",
        "required": true
      },
      {
        "name": "NAMECHEAP_API_IP",
        "description": "Whitelisted public IP configured in Namecheap",
        "required": true
      },
      {
        "name": "NAMECHEAP_ENV",
          "description": "sandbox or production",
          "required": true
      }
    ]
  }
}
